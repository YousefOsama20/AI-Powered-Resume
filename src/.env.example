APP_NAME="ai-power-resume"
APP_VERSION="1.1"

# ── File Upload Settings ───────────────────────────────────────────────────────
FILE_ALLOWED_TYPES=["application/pdf","application/msword","application/vnd.openxmlformats-officedocument.wordprocessingml.document"]
FILE_MAX_SIZE=16
FILE_DEFAULT_CHUNK_SIZE=512000

# ── Vector DB (ChromaDB) ───────────────────────────────────────────────────────
VECTOR_DB_PATH=""
VECTOR_DB_COLLECTION="resume_chunks"

# ── Embedding Model (sentence-transformers) ────────────────────────────────────
EMBEDDING_MODEL_NAME=""
EMBEDDING_BATCH_SIZE=64

# ── LLM Generation (OpenAI-compatible API) ─────────────────────────────────────
GENERATION_BACKEND=""
GENERATION_API_KEY=""
GENERATION_API_URL=""
GENERATION_MODEL_ID=""
GENERATION_MAX_TOKENS=500
GENERATION_TEMPERATURE=0.1

# ========================= Template Configs =========================
PRIMARY_LANG = "en"
DEFAULT_LANG = "en"
